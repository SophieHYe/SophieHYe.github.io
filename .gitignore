# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Ignore files created by MacOS
.DS_Store

# Local-only dev/ops notes (contains internal cluster hostnames; keep out of the public repo)
CLAUDE.md
RESUME_STATE.md

# Local-only working files (private paper queue + draft template)
_pages/rsi-queue.md
_drafts/paper-note-template.md

# Local-only: unpublished TerminalWorld research notes (kept out of the public repo;
# links to these pages are gated behind `show_terminalworld` in _config_docker.yml)
_pages/terminalworld.html
_pages/terminalworld-science.md
